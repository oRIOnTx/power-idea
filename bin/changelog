#!/usr/bin/env bash
# Regenerates CHANGELOG.md from git (released sections from v* tags, plus [Unreleased])
# and prints the Unreleased section: a preview of the next version. Never edit the file by hand.
# Usage: bin/changelog
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v git-cliff >/dev/null 2>&1; then
  echo "git-cliff not found. Install it: brew install git-cliff (see README, Versioning & releases)" >&2
  exit 1
fi
git-cliff --output CHANGELOG.md 2>/dev/null
echo "CHANGELOG.md regenerated. Unreleased:"
echo
git-cliff --unreleased --strip all 2>/dev/null
